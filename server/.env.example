# ScopeLine configuration.
# Copy this file to server/.env and edit it.

# ---------------------------------------------------------------------------
# DEMO MODE — no API key, no billing, no internet needed.
# Checks run on local rules instead of the model. Everything else in the app
# is real: the agreement index, retrieval, the database, the totals, the UI.
# Leave this as true to run the project for free.
# ---------------------------------------------------------------------------
DEMO_MODE=true

# For the full version, set DEMO_MODE=false and add a key from
# https://console.anthropic.com  (API Keys -> Create Key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional
PORT=4000
DATABASE_FILE=./data/scopeline.db
RETRIEVAL_K=4
CORS_ORIGIN=http://localhost:5173
